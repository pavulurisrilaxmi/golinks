{
  "name": "golinks",
  "version": "0.1.0",
  "private": true,
  "description": "Internal URL shortcut service \u2014 go/<slug> redirects for teams.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "bin": {
    "go": "dist/cli/index.js"
  }
}
